# Identitas provider WhatsApp (lihat docs/adr/0001-provider-whatsapp-cloud-api.md)
WHATSAPP_PROVIDER=whatsapp-cloud-api

# Nomor pengirim dan identitasnya — ganti nilai ini untuk cutover ke nomor
# produksi (lihat docs/whatsapp-number-cutover.md), tanpa mengubah kode.
WHATSAPP_SENDER_NUMBER=+62 895 0700 3830
WHATSAPP_PHONE_NUMBER_ID=

# Kredensial WhatsApp Cloud API
WHATSAPP_API_BASE_URL=https://graph.facebook.com/v21.0
WHATSAPP_API_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# Port proses bot
PORT=3000
