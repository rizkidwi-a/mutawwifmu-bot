# Identitas provider WhatsApp. Pilihan: whatsapp-cloud-api (default, ADR-0001)
# atau fonnte (BSP, ADR-0003). Hanya variabel milik provider terpilih yang wajib
# diisi — lihat docs/whatsapp-number-cutover.md dan
# docs/tutorial-migrasi-ke-meta-cloud-api.md.
WHATSAPP_PROVIDER=whatsapp-cloud-api

# Nomor pengirim — ganti nilai ini untuk cutover ke nomor produksi, tanpa
# mengubah kode (lihat docs/whatsapp-number-cutover.md).
WHATSAPP_SENDER_NUMBER=+62 895 0700 3830

# Rahasia endpoint webhook. Pada Cloud API ini token handshake; pada Fonnte
# token yang disisipkan pada URL webhook (?token=...).
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# Nomor WhatsApp admin penerima handoff (E.164, boleh pakai spasi/tanda +).
# Keputusan pemilik, lihat docs/adr/0006-kanal-admin-whatsapp.md.
WHATSAPP_ADMIN_NUMBER=+62 822 8388 6627

# --- WhatsApp Cloud API (Meta) ---
# Migrasi dari Fonnte ke Cloud API: docs/tutorial-migrasi-ke-meta-cloud-api.md
WHATSAPP_PHONE_NUMBER_ID=
# Versi Graph API; masa berlaku tiap versi: developers.facebook.com/docs/graph-api/changelog
WHATSAPP_API_BASE_URL=https://graph.facebook.com/v26.0
WHATSAPP_API_TOKEN=
WHATSAPP_APP_SECRET=

# --- Fonnte (BSP) ---
# Saat memakai Fonnte, WHATSAPP_API_TOKEN di atas diisi token perangkat Fonnte.
# Dua baris di bawah opsional — biarkan berkomentar untuk memakai default:
# WHATSAPP_API_BASE_URL=https://api.fonnte.com
# WHATSAPP_COUNTRY_CODE=62

# --- Gemini (lapisan pemaham bahasa, ADR-0008 & ADR-0013) ---
# OPSIONAL dan opt-in: hanya aktif bila GEMINI_API_KEY diisi. Tanpa kunci,
# bot tetap berjalan penuh dengan klasifikasi regex. Kunci hanya di .env,
# jangan pernah ditulis ke berkas mana pun.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash

# Port proses bot
PORT=3000
